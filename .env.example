# PropertyYield AI — configuration template.
# Copy to .env and fill in. Never commit real values; in production use a secret
# manager (Azure Key Vault, AWS Secrets Manager, …) instead of a file.

# ----------------------------------------------------------------------------- Core
ENVIRONMENT=development
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_USER=propertyyield
POSTGRES_PASSWORD=
POSTGRES_DB=propertyyield
# Must be true when served over HTTPS (required in production).
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails that are always administrators. The first account
# registered on a new installation is also an administrator.
ADMIN_EMAILS=

# ----------------------------------------------------------------------------- Data mode
# auto = live when RENTCAST_API_KEY is set, otherwise the labelled demo dataset
# demo = always demo data        live = require live providers
DATA_MODE=auto

# ----------------------------------------------------------------------------- RentCast (listings, rent & value estimates, market stats, tax records)
# https://app.rentcast.io/app/api
RENTCAST_API_KEY=
RENTCAST_MONTHLY_REQUEST_BUDGET=1000
RENTCAST_MONTHLY_COST_BUDGET_USD=50
# RENTCAST_COST_PER_REQUEST_USD=0.02
# Enable only if your API version supports "min:max" range syntax on numeric filters.
# RENTCAST_RANGE_FILTERS=false

# ----------------------------------------------------------------------------- AirDNA (short-term rental analytics; enterprise API contract required)
AIRDNA_API_KEY=
# AIRDNA_BASE_URL=https://api.airdna.co/api/enterprise/v2
# AIRDNA_MONTHLY_REQUEST_BUDGET=200
# AIRDNA_MONTHLY_COST_BUDGET_USD=100

# ----------------------------------------------------------------------------- Mapbox
# Secret token for server-side geocoding (radius and county searches).
MAPBOX_ACCESS_TOKEN=
# Public token (pk.…) for the browser map. Restrict it to your domains in the Mapbox dashboard.
MAPBOX_PUBLIC_TOKEN=
# MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# ----------------------------------------------------------------------------- LLM (AI analysis and natural-language search)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# LLM_REFUSAL_FALLBACK=true
# LLM_MONTHLY_REQUEST_BUDGET=2000
# LLM_MONTHLY_COST_BUDGET_USD=50

# ----------------------------------------------------------------------------- Search cost control
# Paid property-level estimates are requested only for the best N candidates per search.
RENT_AVM_TOP_N=15
# The top N are re-checked after verification, for at most this many rounds.
# RENT_AVM_MAX_ROUNDS=2
STR_ESTIMATE_TOP_N=5
# Safety cap; reaching it is always reported to the user as a partial result.
MAX_LISTINGS_PER_SEARCH=10000
# Freshness thresholds (how long cached provider data is reused)
# LISTING_CACHE_TTL_SECONDS=21600
# RENT_ESTIMATE_TTL_DAYS=30
# STR_ESTIMATE_TTL_DAYS=30
# MARKET_STATS_TTL_DAYS=7

# ----------------------------------------------------------------------------- Alerts (optional email delivery)
# ALERTS_INTERVAL_MINUTES=360
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
